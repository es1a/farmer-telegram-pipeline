# Create a bot with @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional: Telegram chat ID of the officer who gets notified.
# Message the bot once, then check logs / persisted data for your chat_id.
OFFICER_CHAT_ID=

# Optional OpenWeatherMap key. Without it, mock weather is used.
OPENWEATHER_API_KEY=

# Default location for weather lookups (farmer region).
DEFAULT_LAT=48.137154
DEFAULT_LON=11.576124
DEFAULT_LOCATION_NAME=Munich
